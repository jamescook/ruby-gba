*.gba
# Cartridge save memory, written by the emulator beside the ROM it belongs to
*.sav
.DS_Store

# Not committed — this is used as an app but the lock stays out of git (fresh resolve in CI)
Gemfile.lock

# The codebase map in .ua/ is committed; these are local scratch from a build of it
.ua/intermediate/
.ua/.trash-*/
.ua/diff-overlay.json

# Per-file test timings, rewritten by every `rake test:parallel` to balance the
# next one. Local by nature: it changes on every run, so committing it would mean
# a conflicting diff on every merge, and all a fresh clone loses is one
# unbalanced run before it builds its own.
.test_timings.json

# SimpleCov's report and merge cache, written only under COVERAGE=1
coverage/

# beads task-tracker db (dolt server, logs, sockets). Never commit: a shell-metacharacter
# bug in a bd command once dumped a live secret straight into this db.
.beads/

# Personal Claude Code settings (permissions, local overrides) — not shared config.
.claude/settings.local.json

# Local agent notes, holding everything about the issue tracker. That tracker is internal to
# one machine, so a checked-in file must not name it; this is where it goes instead.
CLAUDE.local.md

# "rake cost:check passed against exactly this code", read by the pre-commit hook. Local
# by nature: it says what THIS machine has verified, so committing it would tell a fresh
# clone the corpus had been scored when nobody had run anything.
tools/.cost_stamp
