*.gba
# Cartridge save memory, written by the emulator beside the ROM it belongs to
*.sav
.DS_Store

# Not committed — this is used as an app but the lock stays out of git (fresh resolve in CI)
Gemfile.lock

# The codebase map in .ua/ is committed; these are local scratch from a build of it
.ua/intermediate/
.ua/.trash-*/
.ua/diff-overlay.json

# SimpleCov's report, written only under COVERAGE=1
coverage/

# What zig leaves beside a build.zig when it is not told to put it elsewhere: compiled objects,
# fetched packages (SDL's whole source tree), and the output. The native backend always points
# these somewhere else; this is for a zig build run by hand.
.zig-cache/
zig-pkg/
zig-out/

# Desktop programs built by hand (ruby-gba build game.rb --format=native -o build/game).
/build/

# How the native runtime is built, for an editor's C checker. Every native build keeps it
# right (Native::Zig), and it names folders on the machine that wrote it.
/lib/ruby_gba/ir/backends/native/compile_flags.txt*
/test/ruby_gba/ir/backends/native/compile_flags.txt*

# beads task-tracker db (dolt server, logs, sockets). Never commit: a shell-metacharacter
# bug in a bd command once dumped a live secret straight into this db.
.beads/

# Claude Code's project files are shared here: its rules and the DSL reference.
# This undoes a machine-wide ignore of .claude/ that some contributors keep for other repos.
!.claude/

# Personal Claude Code settings (permissions, local overrides) — not shared config.
.claude/settings.local.json

# Local agent notes: what is true of one machine (where a sibling checkout lives) and
# everything about the issue tracker, which is internal to one machine and named nowhere else.
CLAUDE.local.md

# "rake cost:check passed against exactly this code", read by the pre-commit hook. Local
# by nature: it says what THIS machine has verified, so committing it would tell a fresh
# clone the corpus had been scored when nobody had run anything.
tools/.cost_stamp

# Opt in, per machine, to the commit-msg hook's message review (see .githooks/commit-msg).
# Local by nature: whether a machine has `claude` on its PATH and wants to spend a call on
# every commit is that machine's business, not the repo's.
.enable-claude-commit-review
