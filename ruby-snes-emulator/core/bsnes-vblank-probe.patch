diff --git a/bsnes/sfc/ppu/ppu.cpp b/bsnes/sfc/ppu/ppu.cpp
index dc8d135..5bfd380 100644
--- a/bsnes/sfc/ppu/ppu.cpp
+++ b/bsnes/sfc/ppu/ppu.cpp
@@ -13,6 +13,59 @@ PPU ppu;
 #include "serialization.cpp"
 #include "counter/serialization.cpp"
 
+//VBLANK PROBE: the console's memories, copied out for a test harness that compares a running
+//cartridge with an interpreter (see target-libretro's retro_get_memory_data). Laid out as the
+//console's own ports read them: video RAM as 64K bytes, low byte of each word first; the colour
+//memory as 256 little-endian words; the sprite table as its 544 bytes, encoded back from the
+//decoded objects bsnes keeps. The 65816's registers are a sixteen-byte record: PC (3 bytes),
+//A, X, Y, S, D (2 bytes each), DB, P, and the emulation flag. Only the accurate PPU is read.
+//+id+ is 1 video RAM, 2 colour memory, 3 sprite table, 4 registers. Gives the bytes written.
+auto PPU::probe(uint id, uint8* out) -> uint {
+  switch(id) {
+  case 1:
+    for(uint i : range(32 * 1024)) {
+      out[i * 2 + 0] = vram.data[i] >> 0;
+      out[i * 2 + 1] = vram.data[i] >> 8;
+    }
+    return 64 * 1024;
+  case 2:
+    for(uint i : range(256)) {
+      out[i * 2 + 0] = screen.cgram[i] >> 0;
+      out[i * 2 + 1] = screen.cgram[i] >> 8;
+    }
+    return 512;
+  case 3:
+    for(uint i : range(544)) out[i] = obj.oam.read(i);
+    return 544;
+  case 4: {
+    uint values[] = {cpu.r.a.w, cpu.r.x.w, cpu.r.y.w, cpu.r.s.w, cpu.r.d.w};
+    out[0] = cpu.r.pc.d >> 0;
+    out[1] = cpu.r.pc.d >> 8;
+    out[2] = cpu.r.pc.d >> 16;
+    for(uint i : range(5)) {
+      out[3 + i * 2] = values[i] >> 0;
+      out[4 + i * 2] = values[i] >> 8;
+    }
+    out[13] = cpu.r.b;
+    out[14] = (uint)cpu.r.p;
+    out[15] = cpu.r.e;
+    return 16;
+  }
+  }
+  return 0;
+}
+
+//The probe's front door, for a translation unit that cannot see the PPU's insides: +id+ 0 is
+//work RAM (handed over live, 128K), 5 the cartridge's battery-backed RAM (live), and the rest
+//PPU::probe's copies. Gives where the bytes are, or nullptr, and their count in +size+.
+auto vblankProbe(uint id, uint8* out, uint& size) -> uint8* {
+  if(id == 0) { size = sizeof(cpu.wram); return cpu.wram; }
+  if(id == 5) { size = cartridge.ram.size(); return size ? cartridge.ram.data() : nullptr; }
+  if(system.fastPPU() && id != 4) { size = 0; return nullptr; }
+  size = ppu.probe(id, out);
+  return size ? out : nullptr;
+}
+
 PPU::PPU() :
 bg1(Background::ID::BG1),
 bg2(Background::ID::BG2),
