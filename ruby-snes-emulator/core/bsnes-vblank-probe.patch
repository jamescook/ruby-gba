diff --git a/bsnes/target-libretro/libretro.cpp b/bsnes/target-libretro/libretro.cpp
index fc7f321..e87fb84 100644
--- a/bsnes/target-libretro/libretro.cpp
+++ b/bsnes/target-libretro/libretro.cpp
@@ -769,14 +769,43 @@ RETRO_API unsigned retro_get_region()
 	return program->superFamicom.region == "NTSC" ? RETRO_REGION_NTSC : RETRO_REGION_PAL;
 }
 
-// Currently, there is no safe/sensible way to use the memory interface without severe hackery.
-// Rely on higan to load and save SRAM until there is really compelling reason not to.
-RETRO_API void *retro_get_memory_data(unsigned id)
+// VBLANK PROBE: the console's memories for a test harness that compares a running cartridge with
+// an interpreter (SuperFamicom::vblankProbe in sfc/ppu/ppu.cpp says how each is laid out). Work
+// RAM and the cartridge's RAM are the standard ids; the colour memory, the sprite table and the
+// 65816's registers are ids of their own. The PPU's are read from the accurate PPU, so the core
+// must be told bsnes_ppu_fast=OFF.
+#define RETRO_MEMORY_VBLANK_CGRAM     0x8001
+#define RETRO_MEMORY_VBLANK_OAM       0x8002
+#define RETRO_MEMORY_VBLANK_REGISTERS 0x8003
+
+namespace SuperFamicom { auto vblankProbe(uint id, uint8* out, uint& size) -> uint8*; }
+
+static uint8 vblank_copy[64 * 1024];
+
+static uint8 *vblank_memory(unsigned id, uint &size)
 {
+	switch(id)
+	{
+		case RETRO_MEMORY_SYSTEM_RAM:       return SuperFamicom::vblankProbe(0, vblank_copy, size);
+		case RETRO_MEMORY_VIDEO_RAM:        return SuperFamicom::vblankProbe(1, vblank_copy, size);
+		case RETRO_MEMORY_VBLANK_CGRAM:     return SuperFamicom::vblankProbe(2, vblank_copy, size);
+		case RETRO_MEMORY_VBLANK_OAM:       return SuperFamicom::vblankProbe(3, vblank_copy, size);
+		case RETRO_MEMORY_VBLANK_REGISTERS: return SuperFamicom::vblankProbe(4, vblank_copy, size);
+		case RETRO_MEMORY_SAVE_RAM:         return SuperFamicom::vblankProbe(5, vblank_copy, size);
+	}
+	size = 0;
 	return nullptr;
 }
 
+RETRO_API void *retro_get_memory_data(unsigned id)
+{
+	uint size;
+	return vblank_memory(id, size);
+}
+
 RETRO_API size_t retro_get_memory_size(unsigned id)
 {
-	return 0;
+	uint size;
+	vblank_memory(id, size);
+	return size;
 }
