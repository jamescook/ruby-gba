# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.

# --- Scope: framework + examples, not the test suite ---

test/
ruby-gba-emulator/

# --- Build artifacts (gitignored) ---

*.gba
Gemfile.lock
.DS_Store
.claude/

# Issue-tracker database, logs and sockets — not code, and it changes every command.
.beads/

# This tool's own output. Without this it analyses its own knowledge graph (17k lines) and
# fingerprint baseline (5k) as if they were project config.
.ua/

# Wolfenstein moved to its own repository (~/open_source/ruby-wolf3d). What is left here is
# built cartridges and a stray config pointer, no source.
games/

# --- Binary assets (art, audio, sprite sheets) — nothing to read ---

*.png
*.gif
*.jpg
*.jpeg
*.bmp
*.wav
*.aseprite
*.mid
*.midi
*.sav
