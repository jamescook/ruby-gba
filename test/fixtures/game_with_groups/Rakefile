# frozen_string_literal: true

# A game's own Rakefile that keeps its own rake test and a task for each group of its tests, and
# asks the library only for a native twin of a group: VBlank::Testing::TestTask. Its game code is
# not under lib/. test/all/vblank/testing/test_game_suite.rb runs it.
require "vblank/testing/test_task" # rake's own test task comes with it

LIBS = %w[game/code test].freeze

Rake::TestTask.new(:test) do |t|
  t.libs = LIBS
  t.test_files = FileList["test/**/*_test.rb"]
end

namespace :test do
  Rake::TestTask.new(:walking) do |t|
    t.libs = LIBS
    t.test_files = FileList["test/walking/*_test.rb"]
  end

  namespace :native do
    VBlank::Testing::TestTask.new(:walking) do |t|
      t.lowering = :native
      t.libs = LIBS
      t.test_files = FileList["test/walking/*_test.rb"]
    end
  end
end
