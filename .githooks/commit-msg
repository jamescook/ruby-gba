#!/bin/sh
# Block commit messages that embed a bead/tracker id (e.g. gba-5lp).
#
# Beads is internal to the workflow; git history is for humans, and a reader of the
# log has no access to the tracker — the id is noise, and it leaks the internal
# process into permanent history. Describe the change instead.
#
# Matches the lowercase "gba-<id>" form the tracker uses (case-sensitive, so prose
# like "GBA-based" is fine). Comment lines are ignored. Bypass a genuine false
# positive with:  git commit --no-verify

msg_file="$1"

# The real message, minus git's comment/scissor lines.
body=$(grep -vE '^[[:space:]]*#' "$msg_file")

# THE PROJECT'S OWN NAMES CONTAIN "gba-" AND ARE NOT BEAD IDS. "ruby-gba-emulator" holds
# "gba-emulator", which matches the id pattern exactly, so without this every commit message
# that names the emulator gem is refused. Blank those names out before scanning rather than
# trying to write a cleverer pattern: grep here has no lookbehind, and the list is short and
# says plainly which names are exempt.
scannable=$(printf '%s\n' "$body" | sed -e 's/ruby-gba-emulator//g' -e 's/ruby-gba//g')

ids=$(printf '%s\n' "$scannable" | grep -Eo 'gba-[a-z0-9]{3,}' | sort -u | tr '\n' ' ')

if [ -n "$ids" ]; then
  echo "commit-msg: this message names a bead id: ${ids}" >&2
  echo "Keep tracker ids out of git history — say what the change does, not which bead it's for." >&2
  echo "(Genuine false positive? re-run with: git commit --no-verify)" >&2
  exit 1
fi

exit 0
