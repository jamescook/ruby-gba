# Built C-extension artifacts — regenerated by `rake compile`.
#
# The library itself lands in lib/ruby_gba_emulator/, which is where extconf installs it and
# where an ordinary require finds it. The intermediate build junk stays in ext/ beside the
# sources.
lib/ruby_gba_emulator/*.so
lib/ruby_gba_emulator/*.bundle
lib/ruby_gba_emulator/*.bundle.dSYM/

ext/ruby_gba_emulator_ext/Makefile
ext/ruby_gba_emulator_ext/*.o
ext/ruby_gba_emulator_ext/*.so
ext/ruby_gba_emulator_ext/*.bundle
ext/ruby_gba_emulator_ext/*.bundle.dSYM/
ext/ruby_gba_emulator_ext/mkmf.log

# make's install-stamp, written by the install-so step that puts the library in lib/.
ext/ruby_gba_emulator_ext/.sitearchdir.*.time
